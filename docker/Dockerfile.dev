# syntax=docker/dockerfile:1.7
# Development image — hot reload (nodemon), tüm devDependencies dahil.

FROM node:20-alpine
WORKDIR /app

RUN apk add --no-cache tini curl

COPY package*.json ./
RUN npm install

ENV NODE_ENV=development \
    PORT=3000

EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["npm", "run", "dev"]
