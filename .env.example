# ── Server ──────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (MySQL — on-premise container) ─────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ogm_gonullu
DB_USER=ogm_app
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_strong_root_password

# ── Redis (on-premise container) ────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ── JWT ─────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REGISTRATION_EXPIRES_IN=30m

# ── Email (Kurumsal SMTP) ──────────────────────
SMTP_HOST=mail.ogm.gov.tr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=gonullu-sistem@ogm.gov.tr
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM_NAME=OGM Gönüllü Sistemi
SMTP_FROM_EMAIL=noreply@ogm.gov.tr

# ── SMS / OTP ───────────────────────────────────
# Sağlayıcılar: mock | netgsm
SMS_PROVIDER=mock
SMS_API_URL=https://api.netgsm.com.tr
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=OGM GONULLU
SMS_OTP_LENGTH=6
SMS_OTP_EXPIRES_IN=300
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_LOCKOUT_DURATION=1800
SMS_DAILY_LIMIT_PER_USER=10
SMS_RESEND_COOLDOWN=30

# ── e-Devlet ────────────────────────────────────
# Mock mode: gerçek e-Devlet entegrasyonu (2-6 ay onay süresi) gelene kadar dev'de true.
EDEVLET_ENABLED=true
EDEVLET_MOCK_MODE=true
EDEVLET_AUTHORIZE_URL=https://sanal-test.turkiye.gov.tr/oauth/authorize
EDEVLET_TOKEN_URL=https://sanal-test.turkiye.gov.tr/oauth/token
EDEVLET_USERINFO_URL=https://sanal-test.turkiye.gov.tr/oauth/userinfo
EDEVLET_CLIENT_ID=
EDEVLET_CLIENT_SECRET=
EDEVLET_CALLBACK_URL=https://api.ogm-gonullu.gov.tr/v1/auth/edevlet/callback
EDEVLET_SESSION_TTL=600

# ── Upload / Storage ────────────────────────────
UPLOAD_DIR=/app/uploads
UPLOAD_PUBLIC_BASE_URL=
UPLOAD_MAX_DOC_BYTES=10485760
UPLOAD_MAX_AVATAR_BYTES=5242880
UPLOAD_MAX_REPORT_PHOTOS=5

# ── App URLs ────────────────────────────────────
APP_URL=http://localhost
API_URL=http://localhost:3000

# ── Swagger / OpenAPI ───────────────────────────
SWAGGER_ENABLED=true

# ── Firebase (outbound internet gerektirir) ────
FIREBASE_PROJECT_ID=ogm-gonullu
FIREBASE_CREDENTIALS_PATH=/app/firebase-sa.json

# ── Nominatim (opsiyonel, on-premise container) ─
NOMINATIM_URL=

# ── Logging ─────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=/app/logs
